# Postgres connection string.
# Get one for free from Neon (https://neon.tech) or via the Vercel Marketplace
# (Vercel Dashboard -> Storage -> Neon Postgres), which injects this automatically.
# Any standard Postgres connection string works.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Timezone used to decide what "today" means for the daily reset.
# Defaults to America/Chicago if unset. Use any IANA timezone name.
APP_TIMEZONE="America/Chicago"
